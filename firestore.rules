rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /routes/{routeId} {
   allow get, list: if resource.data.visibility == 'public';
   allow create: if request.auth != null
     && request.resource.data.keys().hasOnly(['ownerUid','name','description','visibility','points','createdAt'])
     && request.resource.data.ownerUid == request.auth.uid
     && request.resource.data.visibility == 'public'
     && request.resource.data.name is string
     && request.resource.data.name.size() >= 3
     && request.resource.data.name.size() <= 100
     && request.resource.data.description is string
     && request.resource.data.description.size() <= 500
     && request.resource.data.points is list
     && request.resource.data.points.size() >= 2
     && request.resource.data.points.size() <= 1000
     && request.resource.data.createdAt == request.time;
   allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
   allow update: if false;
  }
 }
}